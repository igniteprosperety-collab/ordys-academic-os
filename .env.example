# Copie para .env e preencha com os valores do seu ambiente.
# NUNCA versione o .env nem cole segredos no código do frontend.

# --- Público (pode ir para o bundle do navegador) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Servidor (nunca use prefixo VITE_ nestes) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Segredos: apenas no secret manager do ambiente ---
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# GOOGLE_OAUTH_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=
