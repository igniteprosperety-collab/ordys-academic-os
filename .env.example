# Copie para .env e preencha com os valores do seu ambiente.
# NUNCA versione o .env nem cole segredos no código do frontend.

# --- Público (pode ir para o bundle do navegador) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Origem HTTPS canônica do app; necessária no Android nativo.
# Informe somente https://dominio, sem caminho, query ou fragmento.
VITE_PUBLIC_APP_URL=

# --- Servidor (nunca use prefixo VITE_ nestes) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Asaas: somente Sandbox nesta etapa; segredos apenas no secret manager ---
ASAAS_ENVIRONMENT=sandbox
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=  # mínimo de 32 caracteres, sem espaços

# --- Segredos do Supabase: somente no secret manager ---
# Use uma das formas abaixo conforme o runtime:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEYS={"default":"<server-side-secret-key>"}
# LOVABLE_API_KEY=
# GOOGLE_OAUTH_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=
